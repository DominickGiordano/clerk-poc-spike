# Clerk API Keys — from clerk.com Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk JWT Public Key (PEM format) — from API Keys → Show JWT Public Key
# Paste the full PEM including BEGIN/END markers. Use \n for newlines in env vars.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# Clerk Frontend API URL — shown on the Clerk Dashboard
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# Phoenix app
DATABASE_URL=ecto://postgres:postgres@localhost/phoenix_app_dev
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
PHX_HOST=localhost
PHX_PORT=4000

# Next.js app (uses same Clerk keys with NEXT_PUBLIC_ prefix for client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Cross-app communication
PHOENIX_API_URL=http://localhost:4000
